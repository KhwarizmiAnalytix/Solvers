module(
    name = "xsigma_solvers",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "googletest", version = "1.16.0")
bazel_dep(name = "google_benchmark", version = "1.9.1")

# Logging library (vendored git submodule), wired as its own Bazel module.
# magic_enum is overridden here so it comes from the vendored copy instead of
# Bazel Central Registry (matches LinearAlgebra). glog/gflags are Logging's
# own optional GLOG-backend deps: Solvers' own code never references them,
# nothing here selects the glog backend, and the sibling LinearAlgebra
# module omits them entirely, so they don't belong in this MODULE.bazel.
bazel_dep(name = "xsigma_logging", version = "1.0.0")
bazel_dep(name = "magic_enum", version = "0.9.8")

local_path_override(
    module_name = "xsigma_logging",
    path = "ThirdParty/Logging",
)

local_path_override(
    module_name = "magic_enum",
    path = "ThirdParty/Logging/ThirdParty/magic_enum",
)

# Eigen is vendored as a git submodule with no MODULE.bazel.
new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

new_local_repository(
    name = "eigen",
    path = "ThirdParty/eigen",
    build_file = "//bazel:eigen.BUILD",
)
