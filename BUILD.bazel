load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "Solvers",
    # The optional backends (Ceres, Ipopt, NLopt, PETSc/TAO) are not wired up as
    # Bazel deps, so their adapters are excluded here; src/api/dispatch.cpp's own
    # SOLVERS_HAS_<NAME> #if (all defined 0 below) reports backend_unavailable
    # instead. See CMakeLists.txt for the CMake side, which compiles the adapter
    # in once the matching SOLVERS_ENABLE_<NAME> option is ON.
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = [
            "src/solvers/ceres_solver.cpp",
            "src/solvers/ipopt_solver.cpp",
            "src/solvers/nlopt_solver.cpp",
            "src/solvers/petsc_tao_solver.cpp",
        ],
    ),
    hdrs = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
        ],
        allow_empty = True,
    ),
    defines = [
        "SOLVERS_HAS_CERES=0",
        "SOLVERS_HAS_IPOPT=0",
        "SOLVERS_HAS_NLOPT=0",
        "SOLVERS_HAS_PETSC=0",
    ],
    # layering_check enforces that each translation unit only uses headers from
    # its direct deps (Clang's -fmodules-strict-decluse equivalent), complementing
    # the IWYU analysis enabled via `bazel build --config=iwyu` in .bazelrc.
    features = ["layering_check"],
    includes = ["include"],
    deps = [
        "@xsigma_logging//:logging_lib",
        "@eigen//:eigen",
    ],
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's `install(TARGETS Solvers ...)` /
# `install(DIRECTORY include/ DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}" ...)`, which
# installs headers flat under "include" rather than "include/Solvers"). `bazel build
# //:solvers_pkg_tar` produces a relocatable tarball; `bazel run //:install --
# --destdir=/some/prefix` stages the same tree directly on disk.
# =============================================================================

pkg_files(
    name = "solvers_installed_hdrs",
    srcs = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
        ],
        allow_empty = True,
    ),
    prefix = "include",
    strip_prefix = strip_prefix.from_pkg("include"),
)

pkg_files(
    name = "solvers_installed_libs",
    srcs = [":Solvers"],
    prefix = "lib",
)

pkg_tar(
    name = "solvers_pkg_tar",
    srcs = [
        ":solvers_installed_hdrs",
        ":solvers_installed_libs",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":solvers_installed_hdrs",
        ":solvers_installed_libs",
    ],
)
