load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "Solvers",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
        ],
        allow_empty = True,
    ),
    defines = [
        "SOLVERS_HAS_CERES=0",
        "SOLVERS_HAS_IPOPT=0",
        "SOLVERS_HAS_PETSC=0",
    ],
    # layering_check enforces that each translation unit only uses headers from
    # its direct deps (Clang's -fmodules-strict-decluse equivalent), complementing
    # the IWYU analysis enabled via `bazel build --config=iwyu` in .bazelrc.
    features = ["layering_check"],
    includes = ["include"],
    deps = [
        "@xsigma_logging//:logging_lib",
        "@eigen//:eigen",
    ],
)
