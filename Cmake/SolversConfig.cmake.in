@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ---------------------------------------------------------------------------
# Eigen3 (vendored submodule, header-only)
# ---------------------------------------------------------------------------
# Solvers installs the raw Eigen/unsupported headers directly (CMakeLists.txt)
# but never generates/installs an Eigen3Config.cmake of its own. Try a system
# Eigen3 package first; if none is present (the common case for this vendored
# setup), fall back to a minimal header-only imported target pointing at the
# headers this package itself installed. This fallback is intentional, not
# redundant with install(EXPORT): nothing else can produce Eigen3::Eigen here.
if(NOT TARGET Eigen3::Eigen)
  find_package(Eigen3 QUIET)
  if(NOT TARGET Eigen3::Eigen)
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    set_target_properties(Eigen3::Eigen PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
    )
  endif()
endif()

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Logging ships its own install(EXPORT)-based LoggingConfig.cmake /
# LoggingTargets.cmake (Solvers vendors it without EXCLUDE_FROM_ALL now, see
# SolversDependencies.cmake, so Logging's own install rules run and its
# package files land alongside Solvers'). find_dependency() it the standard
# way instead of hand-reconstructing Logging::Logging.
find_dependency(Logging)

# loguru: Logging's own LoggingTargets.cmake links loguru (and fmt) PRIVATE,
# and -- verified empirically against the actual generated file -- CMake
# drops that private dependency entirely from the exported
# INTERFACE_LINK_LIBRARIES (it is not merely hidden behind $<LINK_ONLY:>,
# the reference itself comes out empty). That is fine for a SHARED Logging,
# where loguru's object code is baked directly into libLogging.so, but
# Solvers forces Logging to build STATIC when vendoring it
# (SolversDependencies.cmake), so loguru's objects are never merged into
# libLogging.a: an external consumer linking the installed static
# Solvers/Logging still needs loguru on the link line. There is no
# LoguruConfig.cmake to find_dependency() against either, so Solvers
# re-installs/re-exposes the archive itself (CMakeLists.txt) and
# reconstructs the import here -- a deliberate, necessary fallback, not
# something install(EXPORT) could have generated.
if(NOT TARGET Loguru::loguru)
  find_library(_solvers_loguru_path NAMES loguru logurud
    PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" NO_DEFAULT_PATH)
  if(_solvers_loguru_path)
    find_dependency(Threads)
    add_library(Loguru::loguru UNKNOWN IMPORTED)
    set_target_properties(Loguru::loguru PROPERTIES
      IMPORTED_LOCATION "${_solvers_loguru_path}"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/loguru"
      INTERFACE_LINK_LIBRARIES "Threads::Threads"
    )
    if(TARGET Logging::Logging)
      set_property(TARGET Logging::Logging APPEND PROPERTY INTERFACE_LINK_LIBRARIES Loguru::loguru)
    endif()
  endif()
  unset(_solvers_loguru_path)
endif()

# ---------------------------------------------------------------------------
# Optional backends -- mirrors how Parallel reports Parallel_HAS_TBB /
# Parallel_HAS_OPENMP in ParallelConfig.cmake.in.
# ---------------------------------------------------------------------------
set(SOLVERS_HAS_CERES @SOLVERS_ENABLE_CERES@)
set(SOLVERS_HAS_IPOPT @SOLVERS_ENABLE_IPOPT@)
set(SOLVERS_HAS_PETSC @SOLVERS_ENABLE_PETSC@)

# Ceres: Solvers builds it from a vendored submodule (ThirdParty/ceres), not
# a found package, and never installs it, so it has no installed package
# identity of its own here. A consumer must provide its own
# separately-installed Ceres; find_dependency() looks for that. Once found,
# Solvers::Solvers's own $<LINK_ONLY:Ceres::ceres> (below, generated
# automatically by install(EXPORT) since Solvers links Ceres::ceres PRIVATE)
# and Solvers::CeresAutodiff's plain Ceres::ceres (INTERFACE, so its headers
# do propagate -- CeresAutodiff users need them) both resolve against it.
if(SOLVERS_HAS_CERES)
  find_dependency(Ceres QUIET)
endif()

# Ipopt (optional, pkg-config based -- Ipopt has no standard CMake Config
# package upstream, so there is nothing to find_dependency() against).
# QUIET/non-required throughout: Solvers' public headers never expose
# Ipopt's own types (see include/solvers/ipopt_solver.h), so a consumer who
# isn't using the Ipopt backend should not be forced to have it discoverable.
if(SOLVERS_HAS_IPOPT)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(IPOPT QUIET IMPORTED_TARGET ipopt)
  endif()
endif()

# PETSc/TAO (optional, pkg-config based -- same rationale as Ipopt). Plain
# QUIET find_package(), not find_dependency(): find_dependency() would
# forward this package's own REQUIRED-ness onto MPI, and MPI's C component
# can fail to resolve in a consumer project that never enables LANGUAGES C
# (FindMPI needs a C compiler enabled in the *consuming* project to probe
# it) -- which must stay non-fatal, the same as the original Config.
if(SOLVERS_HAS_PETSC)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(PETSC QUIET IMPORTED_TARGET PETSc)
  endif()
  find_package(MPI QUIET COMPONENTS C)
endif()

# ---------------------------------------------------------------------------
# Solvers targets (install(EXPORT)-generated)
# ---------------------------------------------------------------------------
# Solvers::Solvers and (when Ceres is enabled) Solvers::CeresAutodiff are
# both generated here. Solvers links Ceres::ceres / PkgConfig::IPOPT /
# PkgConfig::PETSC / MPI::MPI_C PRIVATE in the main build (CMakeLists.txt);
# for a STATIC library install(EXPORT) still records those as
# $<LINK_ONLY:...> entries (verified against the actual generated file) so
# the final link line still resolves them, while correctly NOT propagating
# their include dirs/compile definitions to consumers -- matching the
# ipopt_solver.h / petsc_tao_solver.h design ("Ipopt's/PETSc's own types
# never cross this header"). No manual re-exposure needed here, unlike
# loguru above: those targets just need to exist (via the find_dependency/
# pkg_check_modules calls above) before this include().
include("${CMAKE_CURRENT_LIST_DIR}/SolversTargets.cmake")

check_required_components(Solvers)
